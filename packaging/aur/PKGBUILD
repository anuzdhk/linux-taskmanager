# Arch Linux / Manjaro / EndeavourOS recipe. Builds a release from source with the system Rust.
# Install: copy this file into an empty folder and run `makepkg -si`.
# Publish to the AUR: `makepkg --printsrcinfo > .SRCINFO`, then push PKGBUILD and .SRCINFO
# to ssh://aur@aur.archlinux.org/taskmonitor.git. Bump pkgver and sha256sums per release.
_repo=https://github.com/anuzdhk/linux-taskmanager
pkgname=taskmonitor
pkgver=0.1.3
pkgrel=1
pkgdesc="A modern task manager for Linux"
arch=('x86_64' 'aarch64')
url="$_repo"
license=('MIT')
depends=('fontconfig' 'libxkbcommon' 'polkit' 'hicolor-icon-theme')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$_repo/archive/v$pkgver.tar.gz")
sha256sums=('56627c5511252dcc6bbdbad92592c407e06ac2ea5e110a05afca5f408c5ec684')
# GitHub names the unpacked folder after the repository.
_dir="linux-taskmanager-$pkgver"

prepare() {
    cd "$_dir"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_dir"
    cargo build --frozen --release -p taskmonitor -p taskmonitor-helper
}

check() {
    cd "$_dir"
    cargo test --frozen --release -p taskmonitor-core
}

package() {
    cd "$_dir"
    packaging/stage.sh target/release "$pkgdir/usr"
}
