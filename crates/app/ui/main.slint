import "../fonts/MonaSans-Light.ttf";
import "../fonts/MonaSans-Regular.ttf";
import "../fonts/MonaSans-Medium.ttf";
import "../fonts/MonaSans-SemiBold.ttf";
import "../fonts/MonaSansMono-Regular.ttf";
import "../fonts/MonaSansMono-Medium.ttf";
import "../fonts/lucide-subset.ttf";

import { Theme, Page } from "theme.slint";
import { Palette } from "std-widgets.slint";
import { Summary, CpuView, MemView, DeviceView, SysView, Metric, ProcRow, ProcTotals, DetailRow, ServiceRow, StartupRow, UserRow, HistoryRow, DiskProcRow } from "types.slint";
export { Theme, Page, Summary, CpuView, MemView, DeviceView, SysView, Metric, ProcRow, ProcTotals, DetailRow, ServiceRow, StartupRow, UserRow, HistoryRow, DiskProcRow }
import { Rail, TopBar } from "shell.slint";
import { Logo } from "components.slint";
import { PerformancePage } from "pages/performance.slint";
import { ProcessesPage } from "pages/processes.slint";
import { DetailsPage } from "pages/details.slint";
import { ConfirmDialog, PropertiesSheet, AffinityDialog, Toast, RunTaskDialog } from "dialogs.slint";
import { ServicesPage } from "pages/services.slint";
import { StartupPage } from "pages/startup.slint";
import { UsersPage } from "pages/users.slint";
import { HistoryPage } from "pages/history.slint";
import { SettingsPage } from "pages/settings.slint";

export component MainWindow inherits Window {
    title: "TaskMonitor";
    icon: @image-url("../../../packaging/icons/hicolor/256x256/apps/io.github.taskmonitor.png");
    preferred-width: 1320px;
    preferred-height: 860px;
    min-width: 1100px;
    min-height: 720px;
    background: Theme.canvas;
    default-font-family: "Mona Sans";
    default-font-size: 14px;

    in property <string> version;
    // Running on Wayland (no always-on-top for apps).
    in property <bool> wayland;
    callback open-url(string);
    // Update checker
    in-out property <bool> auto-update-check: true;
    in property <bool> checking-updates;
    in property <string> update-version;
    in property <string> update-url;
    in property <string> update-status;
    callback check-updates();
    in property <string> user-name;
    in property <string> user-initials;
    in property <Summary> summary: { cpu: "—", ram: "—", gpu: "—", uptime: "—" };
    in property <CpuView> cpu;
    in property <MemView> mem;
    in property <SysView> sys;
    in property <[float]> core-load;
    in property <[DeviceView]> disks;
    in property <[DeviceView]> nets;
    in property <[DeviceView]> gpus;
    in-out property <int> perf-tab;
    callback perf-tab-changed(int);
    // App icons, rendered once in Rust; rows refer to them by index.
    in property <[image]> app-icons;
    in property <[DiskProcRow]> disk-procs;
    in property <[ProcRow]> proc-rows;
    in property <[DetailRow]> detail-rows;
    in property <ProcTotals> proc-totals;
    in property <string> sort-column: "name";
    in property <bool> sort-ascending: true;
    in-out property <string> filter;
    in-out property <string> selected-key;
    in-out property <Page> page: Page.performance;
    callback run-command(string);
    callback refresh-changed(int);
    callback page-changed(Page);
    callback sort(string);
    callback toggle(string);
    callback filter-changed(string);

    // Services, startup apps, users
    in property <[ServiceRow]> service-rows;
    in property <string> service-summary;
    in-out property <bool> service-user-bus;
    in property <[StartupRow]> startup-rows;
    in property <[UserRow]> user-rows;
    callback service-bus-changed(bool);
    callback service-act(string, string);
    callback startup-toggled(string, bool);
    callback session-act(string, string);

    // App history and settings
    in property <[HistoryRow]> history-rows;
    in property <string> history-since;
    in-out property <int> theme-choice;
    changed theme-choice => {
        // Slint's own widgets (the About Slint badge, scrollbars) follow Palette, so an
        // explicit choice is applied there too; "unknown" hands it back to the desktop.
        Palette.color-scheme = self.theme-choice == 1 ? ColorScheme.light
            : self.theme-choice == 2 ? ColorScheme.dark
            : ColorScheme.unknown;
        Theme.dark = self.theme-choice == 2 || (self.theme-choice == 0 && Palette.color-scheme == ColorScheme.dark);
    }
    in-out property <int> refresh-index: 1;
    // Whole-UI zoom in percent (Ctrl+Plus / Ctrl+Minus / Ctrl+0); Rust applies it.
    in-out property <int> zoom: 100;
    callback zoom-changed();
    in-out property <int> start-page;
    in-out property <bool> app-history;
    callback settings-changed();
    // CPU / RAM / GPU in the desktop's top bar (system tray).
    in-out property <bool> top-bar-stats;
    callback top-bar-toggled(bool);
    // Closing the window hides it while the top-bar stats keep running.
    in-out property <bool> run-in-background;
    callback background-toggled(bool);
    callback clear-history();
    in-out property <bool> on-top;
    always-on-top: root.on-top;

    // Process actions
    in-out property <string> toast;
    in property <string> props-title;
    in property <[Metric]> props;
    in property <string> props-text;
    property <bool> run-open;
    in-out property <bool> props-open;
    in property <string> affinity-title;
    in property <[bool]> affinity-cpus;
    in-out property <bool> affinity-open;
    property <string> affinity-key;
    property <string> confirm-action;
    property <string> confirm-key;
    callback action(string, string);
    callback properties(string);
    callback affinity-query(string);
    callback affinity-all();
    callback affinity-apply(string);

    // Slint has no clipboard API; a hidden text field's copy() reaches the system clipboard.
    function copy-text(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
        root.toast = "Copied to the clipboard";
    }

    function go(p: Page) {
        root.page = p;
        root.page-changed(p);
    }

    // Kill and End process tree can lose work, so they ask first.
    function request(action: string, key: string) {
        if action == "kill" || action == "tree" || action == "terminate" || action == "clear-history" {
            root.confirm-action = action;
            root.confirm-key = key;
        } else {
            root.action(action, key);
        }
    }

    // Keyboard shortcuts. Text fields get keys first, so typing is unaffected.
    forward-focus: keys;
    keys := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control {
                if event.text == "1" { root.go(Page.processes); return accept; }
                if event.text == "2" { root.go(Page.performance); return accept; }
                if event.text == "3" { root.go(Page.history); return accept; }
                if event.text == "4" { root.go(Page.startup); return accept; }
                if event.text == "5" { root.go(Page.users); return accept; }
                if event.text == "6" { root.go(Page.details); return accept; }
                if event.text == "7" { root.go(Page.services); return accept; }
                if event.text == "+" || event.text == "=" { root.zoom = min(150, root.zoom + 10); root.zoom-changed(); return accept; }
                if event.text == "-" { root.zoom = max(80, root.zoom - 10); root.zoom-changed(); return accept; }
                if event.text == "0" { root.zoom = 100; root.zoom-changed(); return accept; }
            }
            if event.text == Key.Escape {
                root.confirm-action = "";
                root.run-open = false;
                root.props-open = false;
                root.affinity-open = false;
                return accept;
            }
            if event.text == Key.Delete && root.selected-key != "" && (root.page == Page.processes || root.page == Page.details) {
                root.request("end", root.selected-key);
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 20px;
            spacing: 20px;

            HorizontalLayout {
                spacing: 20px;
                VerticalLayout {
                    alignment: center;
                    Logo { size: 52px; }
                }
                TopBar {
                    refresh-index <=> root.refresh-index;
                    user-name: root.user-name;
                    user-initials: root.user-initials;
                    summary: root.summary;
                    refresh-changed(i) => { root.refresh-changed(i); }
                    top-bar-stats: root.top-bar-stats;
                    update-version: root.update-version;
                    update-clicked => { root.go(Page.settings); }
                    top-bar-toggled => {
                        root.top-bar-stats = !root.top-bar-stats;
                        root.top-bar-toggled(root.top-bar-stats);
                    }
                    // The quick toggle picks an explicit theme and remembers it.
                    theme-toggled => {
                        root.theme-choice = Theme.dark ? 1 : 2;
                        root.settings-changed();
                    }
                }
            }

            HorizontalLayout {
                spacing: 20px;
                Rail {
                    current: root.page;
                    selected(p) => {
                        root.page = p;
                        root.page-changed(p);
                    }
                    end-task => {
                        if root.selected-key != "" && (root.page == Page.processes || root.page == Page.details) {
                            root.request("end", root.selected-key);
                        } else {
                            root.toast = "Select a process on the Processes or Details page first";
                        }
                    }
                }

                if root.page == Page.performance: PerformancePage {
                    user-name: root.user-name;
                    user-initials: root.user-initials;
                    uptime: root.summary.uptime;
                    cpu: root.cpu;
                    mem: root.mem;
                    sys: root.sys;
                    core-load: root.core-load;
                    disks: root.disks;
                    nets: root.nets;
                    gpus: root.gpus;
                    tab <=> root.perf-tab;
                    tab-changed(t) => { root.perf-tab-changed(t); }
                    open-users => {
                        root.page = Page.users;
                        root.page-changed(Page.users);
                    }
                    disk-procs: root.disk-procs;
                    icons: root.app-icons;
                }
                if root.page == Page.processes: ProcessesPage {
                    run-task => { root.run-open = true; }
                    icons: root.app-icons;
                    rows: root.proc-rows;
                    totals: root.proc-totals;
                    sort-column: root.sort-column;
                    ascending: root.sort-ascending;
                    filter <=> root.filter;
                    selected-key <=> root.selected-key;
                    sort(c) => { root.sort(c); }
                    toggle(k) => { root.toggle(k); }
                    filter-edited(t) => { root.filter-changed(t); }
                    request(a, k) => { root.request(a, k); }
                    properties(k) => { root.properties(k); }
                    affinity(k) => {
                        root.affinity-key = k;
                        root.affinity-query(k);
                    }
                }
                if root.page == Page.history: HistoryPage {
                    icons: root.app-icons;
                    rows: root.history-rows;
                    enabled: root.app-history;
                    since: root.history-since;
                    enable => {
                        root.app-history = true;
                        root.settings-changed();
                    }
                    clear => { root.request("clear-history", ""); }
                }
                if root.page == Page.startup: StartupPage {
                    icons: root.app-icons;
                    rows: root.startup-rows;
                    toggled(id, on) => { root.startup-toggled(id, on); }
                }
                if root.page == Page.users: UsersPage {
                    rows: root.user-rows;
                    act(verb, key) => {
                        if verb == "terminate" {
                            root.request(verb, key);
                        } else {
                            root.session-act(verb, key);
                        }
                    }
                }
                if root.page == Page.details: DetailsPage {
                    rows: root.detail-rows;
                    totals: root.proc-totals;
                    sort-column: root.sort-column;
                    ascending: root.sort-ascending;
                    filter <=> root.filter;
                    selected-key <=> root.selected-key;
                    sort(c) => { root.sort(c); }
                    filter-edited(t) => { root.filter-changed(t); }
                    request(a, k) => { root.request(a, k); }
                    properties(k) => { root.properties(k); }
                    affinity(k) => {
                        root.affinity-key = k;
                        root.affinity-query(k);
                    }
                }
                if root.page == Page.services: ServicesPage {
                    rows: root.service-rows;
                    summary: root.service-summary;
                    user-bus: root.service-user-bus;
                    filter <=> root.filter;
                    filter-edited(t) => { root.filter-changed(t); }
                    bus-changed(user) => {
                        root.service-user-bus = user;
                        root.service-bus-changed(user);
                    }
                    act(verb, name) => { root.service-act(verb, name); }
                }
                if root.page == Page.settings: SettingsPage {
                    theme <=> root.theme-choice;
                    zoom <=> root.zoom;
                    zoom-changed => { root.zoom-changed(); }
                    refresh-index <=> root.refresh-index;
                    start-page <=> root.start-page;
                    always-on-top <=> root.on-top;
                    app-history <=> root.app-history;
                    top-bar-stats <=> root.top-bar-stats;
                    run-in-background <=> root.run-in-background;
                    version: root.version;
                    wayland: root.wayland;
                    changed => { root.settings-changed(); }
                    top-bar-toggled(on) => { root.top-bar-toggled(on); }
                    background-toggled(on) => { root.background-toggled(on); }
                    clear-history => { root.request("clear-history", ""); }
                    open-url(url) => { root.open-url(url); }
                    auto-update-check <=> root.auto-update-check;
                    checking-updates: root.checking-updates;
                    update-version: root.update-version;
                    update-url: root.update-url;
                    update-status: root.update-status;
                    check-updates => { root.check-updates(); }
                }
            }
        }
    }

    if root.confirm-action != "": ConfirmDialog {
        width: root.width;
        height: root.height;
        title: root.confirm-action == "kill" ? "Kill this process?"
            : root.confirm-action == "terminate" ? "Sign out this session?"
            : root.confirm-action == "clear-history" ? "Clear app history?"
            : "End the whole process tree?";
        message: root.confirm-action == "kill"
            ? "It stops immediately, without a chance to save. Unsaved work in it will be lost."
            : root.confirm-action == "terminate"
            ? "Every app in the session is closed. Unsaved work in them will be lost."
            : root.confirm-action == "clear-history"
            ? "Everything recorded so far is deleted. Recording continues from now."
            : "This ends the process and every process it started. Unsaved work in any of them will be lost.";
        confirm-text: root.confirm-action == "kill" ? "Kill"
            : root.confirm-action == "terminate" ? "Sign out"
            : root.confirm-action == "clear-history" ? "Clear history"
            : "End process tree";
        dismiss => { root.confirm-action = ""; }
        confirmed => {
            if root.confirm-action == "terminate" {
                root.session-act("terminate", root.confirm-key);
            } else if root.confirm-action == "clear-history" {
                root.clear-history();
            } else {
                root.action(root.confirm-action, root.confirm-key);
            }
            root.confirm-action = "";
        }
    }

    if root.props-open: PropertiesSheet {
        width: root.width;
        height: root.height;
        title: root.props-title;
        facts: root.props;
        all-text: root.props-text;
        copy(text) => { root.copy-text(text); }
        dismiss => { root.props-open = false; }
    }

    if root.affinity-open: AffinityDialog {
        width: root.width;
        height: root.height;
        title: root.affinity-title;
        cpus: root.affinity-cpus;
        dismiss => { root.affinity-open = false; }
        select-all => { root.affinity-all(); }
        apply => {
            root.affinity-apply(root.affinity-key);
            root.affinity-open = false;
        }
    }

    if root.run-open: RunTaskDialog {
        width: root.width;
        height: root.height;
        user-name: root.user-name;
        dismiss => { root.run-open = false; }
        run(cmd) => {
            root.run-command(cmd);
            root.run-open = false;
        }
    }

    clipboard := TextInput {
        visible: false;
        width: 0;
        height: 0;
    }

    if root.toast != "": Toast {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 28px;
        text: root.toast;
    }
    Timer {
        interval: 4s;
        running: root.toast != "";
        triggered => { root.toast = ""; }
    }
}
